// Comments are ignored: Diary.shared.log("command=\(command)")
Diary.shared.log("ssh connect requested port=\(host.port)", category: "ssh")
Diary.shared.log("custom command supplied=\(!command.isEmpty)", category: "tabs")
Self.log.error("command failed: \(command, privacy: .private(mask: .hash))")
Self.log.error("storage failed: \(error, privacy: .private(mask: .hash))")
