Diary.shared.log("running \(command)", category: "terminal")
Diary.shared.log("session \(sessionID)", category: "session")
Self.log.info("connecting to \(host.username)@\(host.hostname)")
Self.log.debug("argv=\(argv)")
Self.log.info("note=\(note.body)")
Self.log.debug("command buffer=\(commandBuffer)")
Self.log.info("dumped to \(outputPath)")
NSLog("argv=%@", argv)
NSLog("failed: \(error)")
